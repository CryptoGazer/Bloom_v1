# Required only for the natural-language and voice route input (/api/ask).
# Create an API key in Google AI Studio, copy this file to .env, and keep .env private.
GEMINI_API_KEY=

# Pinned stable models. Flash also retries unclear Lite responses, not just provider errors.
# Remove an old GEMINI_MODEL=*-latest override to use these defaults.
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash

# Optional Tiger Data/Timescale PostgreSQL connection. When present, the transit logger dual-writes
# after flushing its local CSV spool. Never expose this URL to web/app.js or commit the real value.
# TIGER_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional read-only Tiger login for the site (docs/transit-history.md). When present, the route card says how
# the line ran on a recent day and /night.html works; without it the site falls back to TIGER_DATABASE_URL.
# On the server use the two limited logins from scripts/transit/tiger_setup.py roles, never the owner's URL.
# TIGER_READ_URL=postgresql://bezna_web:password@host:5432/database?sslmode=require

# Switch the transit history off on the site without touching the logger.
# TIGER_HISTORY=off
