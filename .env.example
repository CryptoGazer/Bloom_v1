# Required only for the natural-language and voice route input (/api/ask).
# Create an API key in Google AI Studio, copy this file to .env, and keep .env private.
GEMINI_API_KEY=

# Optional comma-separated fallbacks. These are the defaults used by backend/ask.py.
# GEMINI_MODEL=gemini-flash-lite-latest,gemini-flash-latest

# Optional Tiger Data/Timescale PostgreSQL connection. When present, the transit logger dual-writes
# after flushing its local CSV spool. Never expose this URL to web/app.js or commit the real value.
# TIGER_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
